{
	"schemaVersion": 1,
	"id": "redbits",
	"version": "${version}",

	"name": "Red Bits",
	"description": "Vanilla style redstone additions and improvements!",

	"icon": "assets/redbits/icon.png",
	"license": "MIT",
	"contact": {
		"homepage": "http://darktree.net/",
		"sources": "https://github.com/magistermaks/mod-redbits",
		"issues": "https://github.com/magistermaks/mod-redbits/issues"
	},

	"accessWidener": "redbits.accesswidener",
	"environment": "*",
	"entrypoints": {
		"main": [
          "net.darktree.redbits.RedBits"
		],
		"client": [
          "net.darktree.redbits.RedBitsClient"
		],
		"modmenu": [
          "net.darktree.redbits.config.Menu"
		],
		"fabric-datagen": [
          "net.darktree.redbits.RedBitsData"
		]
	},

	"mixins": [
		"redbits.mixins.json",
		{
			"config": "redbits.client.mixins.json",
			"environment": "client"
		}
	],

	"depends": {
		"fabricloader": "*",
		"fabric-api": "*",
		"minecraft": ["26.3.x"]
	},

	"recommends": {
		"patchouli": "*"
	},

	"suggests": {
		"led": "*"
	},

	"authors": [
		"magistermaks"
	],

	"contributors": [
		"WarAndroid",
		"ChloeDawn",
		"alphaqu",
		"T0paz",
		"Poly_0000"
	]
}
